PORT=3000
NODE_ENV=development
RELAY_PUBLIC_BASE_URL=http://localhost:3000

# development only — skips real sign-in on /mcp and /ws and acts as this user.
# leave it unset to run the real Google flow locally. never set in production:
# the relay refuses to start.
DEV_USER=dev-user

# real auth (required unless DEV_USER is set in development)
# the relay's own Google OAuth client, type "Web application";
# its redirect URI is RELAY_PUBLIC_BASE_URL + /oauth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# the extension's existing OAuth client id (manifest.json -> oauth2.client_id)
EXTENSION_GOOGLE_CLIENT_ID=
# PKCS8 PEM; one line with literal \n is fine. openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
# SQLite file, e.g. file:relay.db
DATABASE_URL=file:relay.db
# seals the Google refresh tokens the relay keeps (read-only access to a user's
# own synced notes when no browser is connected). 32 random bytes, base64:
#   openssl rand -base64 32
# lose or change it and those tokens become unreadable: people reconnect once.
CREDENTIAL_KEY=
