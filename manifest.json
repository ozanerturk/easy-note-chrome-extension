{
  "manifest_version": 3,
  "name": "Easy Note",
  "version": "3.2.0",
  "description": "Take freeform notes the moment you open a new tab. Double-click anywhere to start writing.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Easy Note",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/clip/background.js",
    "type": "module"
  },
  "commands": {
    "clip-region": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Clip a region of this page to Easy Note"
    }
  },
  "permissions": [
    "identity",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "oauth2": {
    "client_id": "1042376880553-kb4u1v9rbhjn4b3tn3i8scl28l2nnlo5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}
